#!/usr/bin/env bash
set -euo pipefail

GCTRL_DIR="${GCTRL_DIR:-$HOME/gctrl}"

BLUE='\033[0;34m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
info()    { echo -e "${BLUE}[GCTRL]${NC} $1"; }
success() { echo -e "${GREEN}[GCTRL]${NC} $1"; }
skip()    { echo -e "${YELLOW}[GCTRL]${NC} $1"; }

if [ ! -f "$GCTRL_DIR/docker-compose.yml" ]; then
  echo "[GCTRL] ERROR: No docker-compose.yml found in $GCTRL_DIR"
  echo "[GCTRL] Set GCTRL_DIR to your installation directory and retry."
  exit 1
fi

cd "$GCTRL_DIR"

# ── Superseded-image cleanup ──────────────────────────────────────────────────
# Every GCTRL image ships under a floating :latest tag, so each pull moves the
# tag to the new image and strands the previous one on disk - untagged, unused
# and, until now, forever. On a long-lived install that grew without bound.
#
# Only images belonging to a repo GCTRL publishes are ever considered, and only
# when no container - running OR stopped - still references them. A blanket
# `docker image prune` is deliberately NOT used: this host may run unrelated
# stacks (n8n, Traefik, other compose projects) whose dangling images it would
# collect too, which would be an unrecoverable surprise.
#
# Attribution still works after the tag has moved because the superseded image
# keeps its ghcr.io/gctrl-tech/<svc>@sha256:... digest reference.
#
# Set GCTRL_KEEP_OLD_IMAGES=1 to disable (an air-gapped host can only roll back
# to images it still has locally).

# ── Rollback record ───────────────────────────────────────────────────────────
# Writes what to roll back TO, as PULLABLE references (repo@sha256:...).
#
# This has to be a digest: the older updater recorded `docker compose images
# --quiet` output, which is image IDs, and the rollback then ran
# `docker pull <id>` - an ID is not a pullable reference, so it failed, silently
# (|| true), and the rollback quietly did nothing. Recording digests is also what
# lets the cleanup above reclaim old images at all: rollback no longer depends on
# them still being on disk, it re-pulls them.
#
# Containers are listed by NAME rather than through `docker compose ps`: the
# in-app updater recreates containers through the Docker API without copying
# compose's labels, after which compose no longer recognises them as members of
# the project.
record_previous_images() {
  local cids tmp="${GCTRL_DIR}/.previous-images.tmp"

  cids=$(docker ps -aq --filter "name=^gctrl-") || return 0
  [ -n "$cids" ] || return 0

  # shellcheck disable=SC2086  # deliberate word splitting over container ids
  docker inspect -f '{{.Image}}' $cids 2>/dev/null | sort -u \
    | xargs -r docker image inspect -f '{{if .RepoDigests}}{{index .RepoDigests 0}}{{end}}' 2>/dev/null \
    | grep -E '@sha256:' > "$tmp" || true

  # Only replace a usable record with another usable one - never clobber a good
  # rollback target with an empty file.
  if [ -s "$tmp" ]; then
    mv "$tmp" "${GCTRL_DIR}/.previous-images"
  else
    rm -f "$tmp"
  fi
  return 0
}

GCTRL_OWNED_REPOS='ghcr\.io/gctrl-tech/(agent|api|web|kex|fuse|fusion-engine)[:@]'

cleanup_superseded_images() {
  if [ "${GCTRL_KEEP_OLD_IMAGES:-0}" = "1" ]; then
    return 0
  fi

  local ids in_use candidates removed=0
  ids=$(docker images -q | sort -u) || return 0
  [ -n "$ids" ] || return 0

  # Images pinned by a container. Stopped ones count: a `docker start` would
  # boot straight back onto that image.
  in_use=$(docker ps -aq | xargs -r docker inspect -f '{{.Image}}' 2>/dev/null | sort -u) || true

  # shellcheck disable=SC2086  # deliberate word splitting: one inspect for all ids
  candidates=$(docker image inspect $ids \
      --format '{{.Id}} {{join .RepoTags ","}} {{join .RepoDigests ","}}' 2>/dev/null \
    | grep -E "$GCTRL_OWNED_REPOS" | awk '{print $1}') || true

  for id in $candidates; do
    if echo "$in_use" | grep -qx "$id"; then
      continue
    fi
    # No -f on purpose: dockerd then refuses to remove an image that is still
    # referenced, or one carrying several repository references (so a locally
    # pinned :v0.1.x tag survives instead of being silently untagged).
    if docker rmi "$id" >/dev/null 2>&1; then
      removed=$((removed + 1))
    fi
  done

  if [ "$removed" -gt 0 ]; then
    info "Removed $removed superseded image(s)."
  fi
  return 0
}

# ── Per-service digest check ───────────────────────────────────────────────────
# Compares local image digest to remote manifest.
# Returns 0 (has update) or 1 (already current).
needs_update() {
  local image="$1"

  # Local manifest-INDEX digest (what `docker pull <tag>` records for a multi-arch
  # tag). RepoDigests is "image@sha256:...".
  local local_digest
  local_digest=$(docker inspect --format='{{index .RepoDigests 0}}' "$image" 2>/dev/null | sed 's/.*@//' || echo "")

  if [ -z "$local_digest" ]; then
    return 0  # not pulled yet - definitely needs pull
  fi

  # Remote INDEX digest = sha256 of the raw manifest-list bytes. NOTE: the old
  # check grep'd the FIRST child "digest" out of `docker manifest inspect` - for a
  # multi-arch image that's a per-platform digest, never the index digest, so it
  # NEVER matched and every service always showed "update available". Hashing the
  # raw index manifest gives the same digest the daemon stores locally.
  local remote_digest
  remote_digest=$(docker buildx imagetools inspect "$image" --raw 2>/dev/null | sha256sum | awk 'NR==1{print "sha256:"$1}')

  # buildx missing / image unreachable → sha256 of empty input. Can't check → pull.
  if [ -z "$remote_digest" ] || [ "$remote_digest" = "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" ]; then
    return 0  # can't check - pull to be safe
  fi

  if [ "$local_digest" = "$remote_digest" ]; then
    return 1  # already up to date
  fi

  return 0
}

# ── Collect services from compose file ────────────────────────────────────────
# Only check the core GCTRL services - skip bundled infra (postgres, redis, etc.)
SERVICES=(
  "gctrl-agent:ghcr.io/gctrl-tech/agent:latest"
  "gctrl-api:ghcr.io/gctrl-tech/api:latest"
  "gctrl-web:ghcr.io/gctrl-tech/web:latest"
  "gctrl-kex:ghcr.io/gctrl-tech/kex:latest"
  "gctrl-fuse:ghcr.io/gctrl-tech/fuse:latest"
)

echo ""
info "Checking for updates..."
echo ""

TO_UPDATE=()
for entry in "${SERVICES[@]}"; do
  name="${entry%%:*}"
  image="${entry#*:}"
  printf "  %-20s" "$name"
  if needs_update "$image"; then
    echo -e "→ update available"
    TO_UPDATE+=("$name")
  else
    echo -e "✓ up to date"
  fi
done

echo ""

if [ ${#TO_UPDATE[@]} -eq 0 ]; then
  success "Everything is already up to date."
  exit 0
fi

info "Pulling ${#TO_UPDATE[@]} updated service(s): ${TO_UPDATE[*]}"
echo ""

# Record the running version as a rollback target BEFORE anything changes.
record_previous_images

# Reclaim what the PREVIOUS update superseded before pulling several GB. Running
# it here rather than only at the end is what frees the disk at the moment it is
# about to be needed - an update dying halfway through on a full disk was the
# failure this prevents. Everything still in use is skipped, so the running
# version is never at risk.
cleanup_superseded_images

for svc in "${TO_UPDATE[@]}"; do
  docker compose pull "$svc"
done

info "Restarting updated containers..."
docker compose up -d --no-recreate "${TO_UPDATE[@]}"
# --no-recreate skips containers whose config hasn't changed;
# force-recreate only those we just pulled
docker compose up -d --force-recreate "${TO_UPDATE[@]}"

# Every container now runs its new image, so the generation just replaced is
# unreferenced and goes immediately instead of lingering until the next update.
cleanup_superseded_images

echo ""
success "Update complete."
echo ""
docker ps --filter "name=gctrl-" --format "  {{.Names}}\t{{.Status}}"
echo ""
