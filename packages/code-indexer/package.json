{
  "name": "@gctrl/code-indexer",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "description": "GCTRL Codebase KB indexer - tree-sitter symbols, imports, calls, chunks -> IndexBatch",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "import": "./dist/index.js", "require": "./dist/index.cjs", "types": "./dist/index.d.ts" }
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ignore": "^5.3.1",
    "tree-sitter-wasms": "^0.1.12",
    "web-tree-sitter": "^0.25.3"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^2.1.0"
  }
}
